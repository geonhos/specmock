{
  "name": "specmock-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @specmock/core build",
    "test": "pnpm build:core && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:core && pnpm -r typecheck",
    "specmock": "pnpm -s build:core && tsx packages/cli/src/cli.ts",
    "llm:check": "pnpm -s build:core && tsx scripts/live-llm-check.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@specmock/core": "workspace:*",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.16",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
