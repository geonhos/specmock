#!/usr/bin/env bash
# 테스트용 가짜 claude. usage · total_cost_usd · duration_api_ms · modelUsage를 담은 실제 형식의 봉투를 출력한다.
set -euo pipefail
cat > /dev/null
if [ -n "${USAGE_FAIL:-}" ]; then
  if [ -n "${USAGE_FAIL_LONG:-}" ]; then
    long=$(printf 'x%.0s' $(seq 1 300))
    printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"boom %s\\nSECOND-LINE","usage":{"input_tokens":5,"output_tokens":1}}\n' "$long"
    exit 0
  fi
  printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"boom Bearer abcdefghijklmnopqrstuvwxyz0123456789","duration_ms":50,"duration_api_ms":40,"total_cost_usd":0.001,"usage":{"input_tokens":5,"output_tokens":1}}\n'
  exit 0
fi
so='{"endpoints":[]}'
printf '{"type":"result","subtype":"success","is_error":false,"duration_ms":9420,"duration_api_ms":8870,"num_turns":1,"result":"ok","structured_output":%s,"total_cost_usd":0.0219,"usage":{"input_tokens":1842,"output_tokens":611,"cache_creation_input_tokens":3977,"cache_read_input_tokens":12,"cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":3977}},"modelUsage":{"claude-haiku-4-5":{"inputTokens":10,"outputTokens":5,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"costUSD":0.0001,"costBasis":"list"},"claude-sonnet-4-5":{"inputTokens":1842,"outputTokens":611,"cacheReadInputTokens":12,"cacheCreationInputTokens":3977,"costUSD":0.0218,"costBasis":"list"}}}\n' "$so"
